---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface SpriteFrame {
	name: string;
	x: number;
	y: number;
	w: number;
	h: number;
}

interface SpriteManifest {
	width: number;
	height: number;
	frames: SpriteFrame[];
}

interface Props {
	manifest: string;
	names?: 'monsters' | 'items';
	label?: string;
}

const { manifest, names, label = 'sprite' } = Astro.props;
const repoAssetRoot = resolve(process.cwd(), '..', 'public', 'assets', 'blackcrypt', 'amiga');
const assetRoot = existsSync(repoAssetRoot)
	? repoAssetRoot
	: resolve(process.cwd(), 'public', 'assets', 'blackcrypt', 'amiga');
const manifestPath = resolve(assetRoot, 'sprites', `${manifest}.json`);
const spriteManifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as SpriteManifest;
const imagePath = `/assets/blackcrypt/amiga/sprites/${manifest}.png`;

const labels = new Map<string, { visible: string; hover?: string }>();
if (names === 'monsters') {
	const monsterData = JSON.parse(
		readFileSync(resolve(assetRoot, 'data', 'monster-names.json'), 'utf8'),
	) as { groups: Array<{ name: string; frames: string[] }> };
	for (const group of monsterData.groups) {
		for (const frame of group.frames) labels.set(frame, { visible: group.name });
	}
}
if (names === 'items') {
	const itemData = JSON.parse(
		readFileSync(resolve(assetRoot, 'data', 'item-names.json'), 'utf8'),
	) as { catalog: Array<{ iconIndex: number; names: string[] }> };
	for (const item of itemData.catalog) {
		labels.set(`item${String(item.iconIndex).padStart(3, '0')}`, {
			visible: item.names[0] ?? `item${String(item.iconIndex).padStart(3, '0')}`,
			hover: item.names.slice(1).join(' / ') || undefined,
		});
	}
}

const frameKey = (n: number) => `item${String(n).padStart(3, '0')}`;

// 16 confirmed dim/activated pairs in the item-icon bank: a named
// artifact/wand/weapon icon immediately followed, in the bank, by an
// unlit-icon-shaped "glowing" twin that the catalog never names on its
// own (no placed map record ever references it directly -- it's a second
// render state for the same object, not a separate item). Confirmed by
// eye: same weapon silhouette, differing only by an added glow/particle
// overlay. Shown as one card that swaps to the glowing state on hover
// instead of two separate, confusingly-unlabelled cards.
const HOVER_PAIRS: Record<string, string> =
	names === 'items'
		? {
				...Object.fromEntries(
					Array.from({ length: 14 }, (_, n) => 145 + n * 2).map((dim) => [
						frameKey(dim),
						frameKey(dim + 1),
					]),
				),
				[frameKey(69)]: frameKey(70), // FIRE WAND
				[frameKey(98)]: frameKey(99), // STORM WAND
				[frameKey(131)]: frameKey(132), // SCROLL OF DISPELLING
			}
		: {};

// The water skin is a three-state item (full / half / empty) rather than a
// dim/activated pair, so it doesn't fit HOVER_PAIRS -- it's a small click
// easter egg instead: each click advances one step and latches on the last
// one. Deliberately undocumented in the UI; it's meant to be found. A
// handful of two-state consumables/containers get the same treatment.
const CLICK_CHAINS: Record<string, string[]> =
	names === 'items'
		? {
				[frameKey(133)]: [frameKey(133), frameKey(134), frameKey(135)], // WATER SKIN
				[frameKey(13)]: [frameKey(13), frameKey(14)], // QUIVER
				[frameKey(24)]: [frameKey(24), frameKey(25)], // CHEESE
				[frameKey(26)]: [frameKey(26), frameKey(27)], // APPLE
				[frameKey(28)]: [frameKey(28), frameKey(29)], // MEAT
				[frameKey(30)]: [frameKey(30), frameKey(31)], // BACKPACK
				[frameKey(32)]: [frameKey(32), frameKey(33)], // HOLDING BAG
				[frameKey(129)]: [frameKey(129), frameKey(130)], // COFFER
				// The 3 named Gauntlets and 3 named Bracers are each followed, in the
				// bank, by 2 unnamed single-glove/single-bracer icons -- the crossed
				// pair split into its two halves. Same three-state click-to-cycle
				// treatment as the water skin (latches on the second single instead
				// of looping back to the pair -- confirmed by eye: item080/083/086
				// are crossed dual-glove icons, 081-082/084-085/087-088 are single
				// gloves; 089/092/095 are crossed dual-bracer icons, 090-091/093-094/
				// 096-097 are single bracers).
				[frameKey(80)]: [frameKey(80), frameKey(81), frameKey(82)], // GAUNTLETS OF DEXTERITY
				[frameKey(83)]: [frameKey(83), frameKey(84), frameKey(85)], // GAUNTLETS OF THE TITANS
				[frameKey(86)]: [frameKey(86), frameKey(87), frameKey(88)], // GAUNTLETS OF TEMIN
				[frameKey(89)]: [frameKey(89), frameKey(90), frameKey(91)], // BRACERS OF PROTECTION
				[frameKey(92)]: [frameKey(92), frameKey(93), frameKey(94)], // BRACERS OF MIGHT
				[frameKey(95)]: [frameKey(95), frameKey(96), frameKey(97)], // BRACERS OF AGILITY
			}
		: {};

// Floor items store one sprite per view depth (near/mid/far, encoded as a
// "-d0"/"-d1"/"-d2" name suffix) rather than a single icon -- fold each
// group of 3 into one card that cycles through its depth ladder on click.
// Unlike the CLICK_CHAINS above (each a one-way consumable or split-pair
// that correctly latches on its last state), this is a "camera zoom" cycle
// with no natural endpoint, so it loops back to the first depth instead.
const LOOPING_CHAINS = new Set<string>();
if (manifest === 'floor-items') {
	const depthGroups = new Map<string, SpriteFrame[]>();
	for (const frame of spriteManifest.frames) {
		const match = frame.name.match(/^(.+)-d\d+$/);
		if (!match) continue;
		const list = depthGroups.get(match[1]) ?? [];
		list.push(frame);
		depthGroups.set(match[1], list);
	}
	for (const frames of depthGroups.values()) {
		if (frames.length < 2) continue;
		frames.sort((a, b) => a.name.localeCompare(b.name));
		CLICK_CHAINS[frames[0].name] = frames.map((f) => f.name);
		LOOPING_CHAINS.add(frames[0].name);
	}
}

const hiddenFrameNames = new Set([
	...Object.values(HOVER_PAIRS),
	...Object.values(CLICK_CHAINS).flatMap((chain) => chain.slice(1)),
]);

const galleryId = `sprite-gallery-${manifest}`;
const searchId = `${galleryId}-search`;

// Every card's image area shares one slot size (the largest stage needed by
// any visible frame in this manifest), so cards are equal height and
// names/captions align across a grid row -- otherwise a manifest whose
// frames vary a lot in size (e.g. floor-items, which shrink at each of its
// 3 view depths) leaves shorter cards with a ragged caption position.
const slotSize = Math.max(
	1,
	...spriteManifest.frames
		.filter((frame) => !hiddenFrameNames.has(frame.name))
		.map((frame) => Math.min(3, 160 / frame.w, 160 / frame.h) * Math.max(frame.w, frame.h)),
);
---

<div class="gallery-toolbar">
	<label for={searchId}>Filter {label}s</label>
	<input id={searchId} data-sprite-search={manifest} type="search" placeholder={`Search ${label}s`} />
	<span>{spriteManifest.frames.length} frames</span>
</div>

<div id={galleryId} class="sprite-gallery" data-sprite-gallery={manifest}>
	{spriteManifest.frames.map((frame, index) => {
		// The non-first half of a hover pair or click chain isn't its own
		// card -- it's folded into its named twin below.
		if (hiddenFrameNames.has(frame.name)) return null;

		const hoverName = HOVER_PAIRS[frame.name];
		const hoverFrame = hoverName ? spriteManifest.frames.find((f) => f.name === hoverName) : undefined;

		const chainNames = CLICK_CHAINS[frame.name];
		const chainFrames = chainNames
			?.map((name) => spriteManifest.frames.find((f) => f.name === name))
			.filter((f): f is SpriteFrame => f !== undefined);

		const frameInfo = labels.get(frame.name);
		const frameLabel =
			frameInfo?.visible ??
			(manifest === 'floor-items' ? frame.name.replace(/-d\d+$/, '') : frame.name);
		const hoverLabel = frameInfo?.hover;
		const scale = Math.min(3, 160 / frame.w, 160 / frame.h);
		const width = Math.max(1, Math.round(frame.w * scale));
		const height = Math.max(1, Math.round(frame.h * scale));
		const searchText = `${frameLabel} ${frame.name} ${index + 1}`.toLowerCase();
		const bgSize = `${Math.round(spriteManifest.width * scale)}px ${Math.round(spriteManifest.height * scale)}px`;
		const posStr = (f: SpriteFrame) => `-${Math.round(f.x * scale)}px -${Math.round(f.y * scale)}px`;
		return (
			<article class="sprite-card" data-sprite-card={manifest} data-search={searchText}>
				{hoverFrame && (
					<span class="hover-badge" title="Hover to reveal an alternate state" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor"
							stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="23 4 23 10 17 10"></polyline>
							<polyline points="1 20 1 14 7 14"></polyline>
							<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
						</svg>
					</span>
				)}
				<div class="sprite-frame-slot" style={`width:${slotSize}px;height:${slotSize}px;`}>
				<div class="sprite-stage" style={`width:${width}px;height:${height}px;`}>
					{chainFrames && chainFrames.length > 1 ? (
						<div
							class="sprite-layer sprite-layer-click"
							data-click-positions={chainFrames.map(posStr).join(';')}
							data-click-index="0"
							data-click-loop={LOOPING_CHAINS.has(frame.name) ? 'true' : undefined}
							style={`background-image:url('${imagePath}');background-size:${bgSize};background-position:${posStr(chainFrames[0])};`}
							role="img"
							aria-label={frameLabel}
							tabindex="0"
						></div>
					) : hoverFrame ? (
						<div
							class="sprite-layer sprite-layer-swap"
							style={`background-image:url('${imagePath}');background-size:${bgSize};background-position:${posStr(frame)};--hover-pos:${posStr(hoverFrame)};`}
							role="img"
							aria-label={frameLabel}
						></div>
					) : (
						<div
							class="sprite-layer"
							style={`background-image:url('${imagePath}');background-size:${bgSize};background-position:${posStr(frame)};`}
							role="img"
							aria-label={frameLabel}
						></div>
					)}
				</div>
				</div>
				<strong title={hoverLabel}>{frameLabel}</strong>
				<small>
					#{String(index + 1).padStart(3, '0')} · {frame.w}×{frame.h}
				</small>
			</article>
		);
	})}
</div>

<script define:vars={{ manifest }}>
	const input = document.querySelector(`[data-sprite-search="${manifest}"]`);
	const cards = [...document.querySelectorAll(`[data-sprite-card="${manifest}"]`)];
	input?.addEventListener('input', (event) => {
		const query = event.target.value.trim().toLowerCase();
		for (const card of cards) card.hidden = query !== '' && !card.dataset.search.includes(query);
	});

	// Click-to-cycle easter eggs (e.g. the water skin): each click advances
	// to the next state and latches on the last one.
	const clickables = document.querySelectorAll(
		`[data-sprite-gallery="${manifest}"] [data-click-positions]`,
	);
	for (const el of clickables) {
		const positions = el.dataset.clickPositions.split(';');
		const loop = el.dataset.clickLoop === 'true';
		const advance = () => {
			const current = Number(el.dataset.clickIndex);
			const next = loop ? (current + 1) % positions.length : Math.min(current + 1, positions.length - 1);
			el.dataset.clickIndex = String(next);
			el.style.backgroundPosition = positions[next];
		};
		el.addEventListener('click', advance);
		el.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				advance();
			}
		});
	}
</script>

<style>
	.gallery-toolbar {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 1rem;
	}
	.gallery-toolbar label {
		font-weight: 600;
	}
	.gallery-toolbar input {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		font: inherit;
		min-width: min(20rem, 100%);
		padding: 0.45rem 0.65rem;
	}
	.gallery-toolbar span {
		color: var(--sl-color-gray-3);
		font-size: 0.9rem;
	}
	.sprite-gallery {
		display: grid;
		gap: 0.8rem;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
	}
	.sprite-card {
		align-items: center;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.45rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		height: 100%;
		margin: 0;
		min-height: 9rem;
		padding: 0.75rem 0.45rem;
		position: relative;
		text-align: center;
	}
	.sprite-card[hidden] {
		display: none;
	}
	.hover-badge {
		align-items: center;
		background: var(--sl-color-gray-5);
		border-radius: 50%;
		color: var(--sl-color-gray-2);
		display: flex;
		height: 1.15rem;
		justify-content: center;
		position: absolute;
		right: 0.4rem;
		top: 0.4rem;
		width: 1.15rem;
	}
	.sprite-frame-slot {
		align-items: center;
		display: flex;
		justify-content: center;
	}
	.sprite-stage {
		position: relative;
		margin: auto;
	}
	.sprite-layer {
		position: absolute;
		inset: 0;
		background-repeat: no-repeat;
		image-rendering: pixelated;
	}
	/* Hover swaps the icon outright (one image, repositioned), rather than
	   crossfading a second image on top of it. */
	.sprite-card:hover .sprite-layer-swap,
	.sprite-card:focus-within .sprite-layer-swap {
		background-position: var(--hover-pos) !important;
	}
	.sprite-layer-click {
		cursor: pointer;
	}
	.sprite-layer-click:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.sprite-card strong {
		font-size: 0.78rem;
		line-height: 1.15;
		max-width: 100%;
		overflow-wrap: anywhere;
	}
	.sprite-card small {
		color: var(--sl-color-gray-3);
		font-size: 0.7rem;
	}
</style>
