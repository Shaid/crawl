{
  "name": "blackcrypt",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "lint": "eslint src/ tools/",
    "format": "prettier --write 'src/**/*.ts' 'tools/**/*.ts'",
    "extract-data": "npx tsx tools/extract-game-data.ts",
    "build-assets": "npx tsx tools/extract-game-data.ts --assets-only",
    "extract-all": "npm run extract-data && python3 scripts/render_all.py && python3 scripts/extract_monsters.py && python3 scripts/extract_clipper.py"
  },
  "dependencies": {
    "@seer/core": "file:../seer/packages/core",
    "@seer/engine-2d": "file:../seer/packages/engine-2d",
    "@seer/iff": "file:../seer/packages/iff",
    "@seer/pipeline": "file:../seer/packages/pipeline",
    "@seer/smus": "file:../seer/packages/smus",
    "pixi.js": "^8.9.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.0",
    "vitest": "^3.2.0"
  }
}
