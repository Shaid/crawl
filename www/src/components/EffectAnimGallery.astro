---
// Real, frame-accurate spell-effect animations, played back from the
// project's own confirmed particle simulation (scripts/render_bcspeed_eff.py
// -> data/bcspeed-effects-simulated.json), not a static sprite crop. Each
// tick is however many particles were actually alive that tick; this
// component just plays back the recorded (gfkRecord, gfkFrame, x, y) list.
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// Spell/effect names, from docs/blackcrypt/amiga/data-structure.md's
// "Which effect belongs to which spell" (92/95 solved this session).
// Ranges are the confirmed stride-3 lattice for range-3 projectile spells
// (one effect per view depth); range-1 spells own a single index.
const NAMED_RANGES: Array<[number, number, string]> = [
	[1, 1, 'Glyph rune (variant 1)'],
	[2, 2, 'Glyph rune — fire'],
	[3, 3, 'Glyph rune — ice'],
	[4, 4, 'Glyph rune (variant 4)'],
	[5, 5, 'Glyph trigger — HP drain'],
	[6, 6, 'Trap damage — fire'],
	[7, 7, 'Trap damage — ice'],
	[8, 8, 'Glyph trigger — disease'],
	[9, 11, 'Chant of Doom'],
	[12, 14, 'Lightning Field'],
	[15, 17, 'Fireball'],
	[18, 20, 'Freeze'],
	[21, 23, 'Chant of Orlin'],
	[24, 26, 'Stone Fire'],
	[27, 27, 'Swarm'],
	[28, 28, 'Pestilence'],
	[29, 29, 'Remove Trap'],
	[30, 30, 'Remove Glyph'],
	[33, 33, 'Binding'],
	[35, 35, 'Monster attack effect'],
	[36, 36, 'Dispel Magic'],
	[37, 37, 'Item-use effect'],
	[38, 40, 'Blast of Cold (Quake shares index 38)'],
	[41, 43, 'Death'],
	[44, 46, 'Death Storm'],
	[47, 49, 'Diety Strike'],
	[50, 52, 'Disrupt'],
	[53, 55, 'Fire Maelstrom'],
	[56, 58, 'Fire Vortex'],
	[59, 61, 'Fire Wind'],
	[62, 64, 'Ice Strike'],
	[65, 67, 'Lifestealer'],
	[68, 70, 'Mind Strike'],
	[71, 73, 'Poison Cloud'],
	[74, 76, 'Rune of Death'],
	[77, 79, 'Rune of Pain'],
	[80, 82, 'Vorpal Air'],
	[83, 85, 'Chaos'],
	[86, 88, "Gods' Fury"],
	[89, 89, 'Trap detection marker'],
	[90, 90, 'Fountain water'],
	[91, 91, 'Heal / spell-failed marker'],
	[92, 92, "Key doesn't fit marker"],
	[93, 93, 'Boss effect (Estoroth)'],
	[94, 94, 'Boss effect (pre-93)'],
];
const NAMED = new Map<number, string>();
for (const [lo, hi, name] of NAMED_RANGES) for (let i = lo; i <= hi; i++) NAMED.set(i, name);
// 0 is the shared party buff/heal sparkle, used by 9 different spells.
NAMED.set(0, 'Heal / buff sparkle');
// 31, 32, 34 are the confirmed-unattributed residue -- no name to give them.

interface Particle { gfkRecord: number; gfkFrame: number; x: number; y: number }
interface EffectEntry { index: number; groupCount: number; tickCount: number; ticks: Particle[][] }

const repoAssetRoot = resolve(process.cwd(), '..', 'public', 'assets', 'blackcrypt', 'amiga');
const assetRoot = existsSync(repoAssetRoot)
	? repoAssetRoot
	: resolve(process.cwd(), 'public', 'assets', 'blackcrypt', 'amiga');

const simPath = resolve(assetRoot, 'data', 'bcspeed-effects-simulated.json');
const sim = JSON.parse(readFileSync(simPath, 'utf8')) as { effects: EffectEntry[] };
const spriteManifest = JSON.parse(
	readFileSync(resolve(assetRoot, 'sprites', 'bcspeed.json'), 'utf8'),
) as { width: number; height: number; frames: Array<{ name: string; x: number; y: number; w: number; h: number }> };
const spriteFrames = new Map(spriteManifest.frames.map((f) => [f.name, f]));
const imagePath = '/assets/blackcrypt/amiga/sprites/bcspeed.png';
const SPRITE = 16;
const MAX_SCALE = 3;
const MAX_STAGE = 168; // cap so wide-traveling effects (fireballs, swarms) don't blow out the card grid
const PAD = SPRITE; // extra room so particles never clip the stage edge

function bounds(effect: EffectEntry) {
	let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
	for (const tick of effect.ticks) {
		for (const p of tick) {
			minX = Math.min(minX, p.x);
			minY = Math.min(minY, p.y);
			maxX = Math.max(maxX, p.x + SPRITE);
			maxY = Math.max(maxY, p.y + SPRITE);
		}
	}
	if (!isFinite(minX)) return { minX: 0, minY: 0, w: SPRITE, h: SPRITE };
	return { minX: minX - PAD / 2, minY: minY - PAD / 2, w: maxX - minX + PAD, h: maxY - minY + PAD };
}

// Only effects with at least one particle across the whole run are worth a
// card -- a handful of indices in the confirmed-unattributed residue (31,
// 32, 34) or edge cases simulate to nothing visible.
const effects = sim.effects.filter((e) => e.ticks.some((t) => t.length > 0));

const effectStages = effects.map((effect) => {
	const b = bounds(effect);
	const scale = Math.min(MAX_SCALE, MAX_STAGE / b.w, MAX_STAGE / b.h);
	// The tick with the most simultaneous particles -- the closest thing this
	// per-tick particle simulation has to a single "representative" frame,
	// shown as a still image when motion is reduced (and as the initial
	// pre-hydration frame either way).
	const peakTick = effect.ticks.reduce((best, t, i) => (t.length > effect.ticks[best].length ? i : best), 0);
	return { effect, bounds: b, scale, stageW: Math.round(b.w * scale), stageH: Math.round(b.h * scale), peakTick };
});

// Every card's animation area shares one slot size (the largest stage needed
// by any effect), so cards are equal height and names/captions align across
// a grid row regardless of how far an individual effect's particles travel.
const slotSize = Math.max(1, ...effectStages.flatMap((e) => [e.stageW, e.stageH]));
---

<div class="gallery-toolbar">
	<label for="effect-search">Filter effects</label>
	<input id="effect-search" data-effect-search type="search" placeholder="Search effects" />
	<span>{effects.length} of 95 effects simulated · hover to pause</span>
</div>

<div class="effect-gallery" data-effect-gallery>
	{effectStages.map(({ effect, bounds: b, scale, stageW, stageH, peakTick }) => {
		const name = NAMED.get(effect.index) ?? `Effect ${effect.index}`;
		const searchText = `${name} ${effect.index}`.toLowerCase();
		return (
			<article class="effect-card" data-effect-card data-search={searchText}>
				<div class="effect-frame-slot" style={`width:${slotSize}px;height:${slotSize}px;`}>
				<div class="effect-stage" style={`width:${stageW}px;height:${stageH}px;`} data-effect-stage>
					{effect.ticks.map((tick, tickIndex) => (
						<div class:list={['effect-tick', tickIndex === peakTick && 'active']} data-effect-tick data-still-index={peakTick}>
							{tick.map((p) => {
								const frame = spriteFrames.get(`gfk${String(p.gfkRecord).padStart(2, '0')}_f${p.gfkFrame}`);
								if (!frame) return null;
								const left = Math.round((p.x - b.minX) * scale);
								const top = Math.round((p.y - b.minY) * scale);
								return (
									<div
										class="effect-particle"
										style={`width:${SPRITE * scale}px;height:${SPRITE * scale}px;left:${left}px;top:${top}px;background-image:url('${imagePath}');background-size:${spriteManifest.width * scale}px ${spriteManifest.height * scale}px;background-position:-${frame.x * scale}px -${frame.y * scale}px;`}
									/>
								);
							})}
						</div>
					))}
				</div>
				</div>
				<strong>{name}</strong>
				<small>#{effect.index} · {effect.groupCount} group{effect.groupCount === 1 ? '' : 's'} · {effect.tickCount} ticks</small>
			</article>
		);
	})}
</div>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduceMotion) {
		for (const card of document.querySelectorAll<HTMLElement>('[data-effect-card]')) {
			const ticks = [...card.querySelectorAll<HTMLElement>('[data-effect-tick]')];
			if (ticks.length < 2) continue;
			let index = Number(ticks[0]?.dataset.stillIndex ?? 0);
			const advance = () => {
				ticks[index].classList.remove('active');
				index = (index + 1) % ticks.length;
				ticks[index].classList.add('active');
			};
			let timer = window.setInterval(advance, 120);
			card.addEventListener('mouseenter', () => window.clearInterval(timer));
			card.addEventListener('mouseleave', () => {
				timer = window.setInterval(advance, 120);
			});
		}
	}
	// When reduced motion is preferred, every card is left on its build-time
	// -chosen "peak" tick (already marked .active server-side) as a still
	// image -- no timers are started at all.

	const gallery = document.querySelector('[data-effect-gallery]');
	const search = document.querySelector<HTMLInputElement>('[data-effect-search]');
	search?.addEventListener('input', (event) => {
		const query = (event.target as HTMLInputElement).value.trim().toLowerCase();
		for (const card of gallery?.querySelectorAll<HTMLElement>('[data-effect-card]') ?? []) {
			card.hidden = query !== '' && !(card.dataset.search ?? '').includes(query);
		}
	});
</script>

<style>
	.gallery-toolbar {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.5rem 0 1rem;
	}
	.gallery-toolbar label { font-weight: 600; }
	.gallery-toolbar input {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		font: inherit;
		min-width: min(20rem, 100%);
		padding: 0.45rem 0.65rem;
	}
	.gallery-toolbar span { color: var(--sl-color-gray-3); font-size: 0.9rem; }
	.effect-gallery {
		display: grid;
		gap: 0.8rem;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
	}
	.effect-card {
		align-items: center;
		background: #14141c;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.45rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		margin: 0;
		min-height: 11rem;
		padding: 0.75rem;
		text-align: center;
	}
	.effect-card[hidden] { display: none; }
	.effect-frame-slot {
		align-items: center;
		display: flex;
		justify-content: center;
	}
	.effect-stage { position: relative; margin: auto; }
	.effect-tick { position: absolute; inset: 0; opacity: 0; }
	.effect-tick.active { opacity: 1; }
	.effect-particle {
		position: absolute;
		background-repeat: no-repeat;
		image-rendering: pixelated;
	}
	.effect-card strong { line-height: 1.15; font-size: 0.85rem; }
	.effect-card small { color: var(--sl-color-gray-3); font-size: 0.72rem; }
</style>
