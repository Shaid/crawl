---
// Crossfades between the real, walker-rendered dungeon views for one
// tileset (dungeon-<tileset>-view-<variant>.png). Which poses exist, and
// what each one shows, comes from the sidecar manifest
// scripts/render_dungeon_views.ts writes alongside the PNGs
// (dungeon-<tileset>-views.json) -- this component reads it rather than
// assuming a fixed variant list, since which M4/M5 features a given
// tileset's map data actually has varies (e.g. bcdfy has no plaque/alcove
// art at all).
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
	tileset: 'bcdfx' | 'bcdfy' | 'bcdfz';
	caption: string;
}

interface DungeonView {
	variant: string;
	map: number;
	mapLabel: string;
	x: number;
	y: number;
	facing: number;
	facingLabel: string;
	note: string;
}

const { tileset, caption } = Astro.props;
// Unlike the sprite atlases (copied verbatim from the repo's public/assets),
// these rendered views are generated by scripts/render_dungeon_views.ts
// straight into this site's own public/ (see build.mjs) and never exist at
// the repo root -- so, unlike SpriteGallery, this must prefer the local root.
const localAssetRoot = resolve(process.cwd(), 'public', 'assets', 'blackcrypt', 'amiga');
const repoAssetRoot = resolve(process.cwd(), '..', 'public', 'assets', 'blackcrypt', 'amiga');
const assetRoot = existsSync(resolve(localAssetRoot, 'textures')) ? localAssetRoot : repoAssetRoot;
const textureDir = resolve(assetRoot, 'textures');

const manifestPath = resolve(textureDir, `dungeon-${tileset}-views.json`);
const views: DungeonView[] = existsSync(manifestPath)
	? JSON.parse(readFileSync(manifestPath, 'utf8')).views
	: [];
const galleryId = `dungeon-cycle-${tileset}`;
---

<figure class="dungeon-cycle" id={galleryId} data-dungeon-cycle>
	<div class="dungeon-cycle-stage">
		{views.map((view, index) => (
			<img
				src={`/assets/blackcrypt/amiga/textures/dungeon-${tileset}-view-${view.variant}.png`}
				alt={`${caption} — ${view.note} (map ${view.mapLabel} @ ${view.x},${view.y} facing ${view.facingLabel})`}
				class:list={['dungeon-cycle-frame', index === 0 && 'active']}
				data-dungeon-frame
			/>
		))}
	</div>
	<figcaption>{caption}</figcaption>
</figure>

<script>
	for (const gallery of document.querySelectorAll('[data-dungeon-cycle]')) {
		const frames = [...gallery.querySelectorAll('[data-dungeon-frame]')];
		if (frames.length < 2) continue;
		let index = 0;
		const advance = () => {
			frames[index].classList.remove('active');
			index = (index + 1) % frames.length;
			frames[index].classList.add('active');
		};
		let timer = window.setInterval(advance, 2200);
		gallery.addEventListener('mouseenter', () => window.clearInterval(timer));
		gallery.addEventListener('mouseleave', () => {
			timer = window.setInterval(advance, 2200);
		});
	}
</script>

<style>
	.dungeon-cycle {
		margin: 0;
	}
	.dungeon-cycle-stage {
		position: relative;
		width: 208px;
		height: 140px;
		image-rendering: pixelated;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.35rem;
		overflow: hidden;
	}
	.dungeon-cycle-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 400ms ease;
	}
	.dungeon-cycle-frame.active {
		opacity: 1;
	}
	.dungeon-cycle figcaption {
		margin-top: 0.4rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
	}
</style>
